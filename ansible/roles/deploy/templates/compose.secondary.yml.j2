services:
  backend:
    image: ${BACKEND_IMAGE}:${IMAGE_TAG}
    container_name: taitran-backend-2
    ports:
      - "{{ backend_nodes[1].address }}:{{ backend_port }}:8080"
    environment:
      DB_HOST: ${DB_HOST}
      DB_PORT: ${DB_PORT}
      DB_NAME: ontap
      DB_USERNAME: root
      DB_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    restart: unless-stopped
