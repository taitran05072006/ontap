services:
  backend:
    image: ${BACKEND_IMAGE}:${IMAGE_TAG}
    ports:
      - "{{ backend_nodes[1].address }}:{{ backend_port }}:8080"
    environment:
      DB_HOST: ${DB_HOST}
      DB_PORT: ${DB_PORT}
      DB_NAME: ontap
      DB_USERNAME: root
      DB_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    restart: unless-stopped

  frontend:
    image: ${FRONTEND_IMAGE}:${IMAGE_TAG}
    ports:
      - "127.0.0.1:5173:80"
    restart: unless-stopped
